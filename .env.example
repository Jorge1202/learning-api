# ============================================================
# learning-ia-api — Variables de Entorno
# ============================================================
# Copia este archivo a .env y rellena los valores.
# NUNCA subas .env al repositorio.

# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- Base de datos ---
DATABASE_URL="postgresql://user:password@localhost:5432/learning_ia?schema=public"

# --- Capa de abstracción de IA ---
# Cambiar AI_PROVIDER cambia el adaptador en uso. Sin downtime.
AI_PROVIDER=claude
# AI_PROVIDER=gemini

AI_COMPLEX_MODEL=claude-sonnet-4-6
# AI_COMPLEX_MODEL=gemini-2.5-pro

AI_SIMPLE_MODEL=claude-haiku-4-5
# AI_SIMPLE_MODEL=gemini-2.5-flash

# --- API keys de proveedores ---
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# --- Auth ---
JWT_SECRET=changeme-en-produccion
JWT_EXPIRES_IN=7d

# --- CORS ---
WEB_ORIGIN=http://localhost:3000
